{
  "$id": "https://vda231-301.github.io/schemas/VDA_278/VDA_231-301_VDA_278_2016-05_v3.0.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VDA 231-301 testing project JSON schema for VDA 278 2016-05",
  "type": "object",
  "allOf": [{ "$ref": "https://vda231-301.github.io/schemas/generic/VDA_231-301_generic_v3.0.0.schema.json" }],
  "properties": {
    "_type": { "const": "TestingProject" },
    "Topics": {
      "type": "array",
      "items": {
        "type": "object",
        "if": { "$ref": "#/$defs/VDA278.TestSeriesCondition" },
        "then": { "$ref": "#/$defs/VDA278.TestSeries" }
      },
      "contains": { "$ref": "#/$defs/VDA278.TestSeriesCondition" }
    }
  },
  "required": [
    "_id", "_type", "_schemaVersion", "ClientOrderNumber",
    "LaboratoryOrderNumber", "OrderReference", "OrderDate", "ReportDate",
    "Signatory", "Client", "ContractorID", "TestingCenters",
    "ComponentMasters", "Topics"
  ],
  "$defs": {
    "VDA278.TestSeriesCondition": {
      "type": "object",
      "properties": {
        "_type": { "const": "TestSeries" },
        "Specification": {
          "type": "object",
          "properties": {
            "Type": { "const": "VDA" },
            "Number": { "const": "278" },
            "IssueDate": { "const": "2016-05" }
          },
          "required": ["Type", "Number", "IssueDate"]
        }
      },
      "required": ["_type", "Specification"]
    },
    "VDA278.TestSeries": {
      "type": "object",
      "properties": {
        "_type": { "const": "TestSeries" },
        "TestType": { "const": "Thermodesorption" },
        "NumberOfExecutions": { "const": 3 },
        "Specimens": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/VDA278.Specimen" }
        },
        "Executions": {
          "oneOf": [
            { "$ref": "#/$defs/VDA278.ExecutionsDetailedVOCFirst" },
            { "$ref": "#/$defs/VDA278.ExecutionsDetailedVOCSecond" }
          ]
        },
        "ReportedProperties": {
          "type": "array",
          "minItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/VDA278.ReportedPropertyVOCTotalEmission" },
            { "$ref": "#/$defs/VDA278.ReportedPropertyFOGTotalEmission" }
          ],
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/VDA278.ReportedPropertyCLPClassification" },
              { "$ref": "#/$defs/VDA278.ReportedPropertyGADSLClassification" }
            ]
          }
        }
      },
      "required": [
        "Specification", "TestType", "ComponentMasterID", "NumberOfExecutions",
        "PredecessorID", "SuccessorID", "TestingCenterID", "Specimens",
        "Executions", "ReportedProperties"
      ]
    },
    "VDA278.ExecutionsDetailedVOCFirst": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/VDA278.TestExecutionVOCDetailed" },
            { "$ref": "#/$defs/VDA278.TestExecutionVOC1" }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/VDA278.TestExecutionVOCSummary" },
            { "$ref": "#/$defs/VDA278.TestExecutionVOC2" }
          ]
        },
        { "$ref": "#/$defs/VDA278.TestExecutionFOGDetailed" }
      ],
      "items": false
    },
    "VDA278.ExecutionsDetailedVOCSecond": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/VDA278.TestExecutionVOCSummary" },
            { "$ref": "#/$defs/VDA278.TestExecutionVOC1" }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/VDA278.TestExecutionVOCDetailed" },
            { "$ref": "#/$defs/VDA278.TestExecutionVOC2" }
          ]
        },
        { "$ref": "#/$defs/VDA278.TestExecutionFOGDetailed" }
      ],
      "items": false
    },
    "VDA278.TestExecutionVOCDetailed": {
      "type": "object",
      "properties": { "SingleResults": { "$ref": "#/$defs/VDA278.InformationSetVOCDetailed" } },
      "required": ["SpecimenID", "SingleResults"]
    },
    "VDA278.TestExecutionVOCSummary": {
      "type": "object",
      "properties": { "SingleResults": { "$ref": "#/$defs/VDA278.InformationSetVOCSummary" } },
      "required": ["SpecimenID", "SingleResults"]
    },
    "VDA278.TestExecutionVOC1": {
      "type": "object",
      "properties": {
        "Numerator": { "const": 1 },
        "Designation": { "const": "VOC run 1" }
      }
    },
    "VDA278.TestExecutionVOC2": {
      "type": "object",
      "properties": {
        "Numerator": { "const": 2 },
        "Designation": { "const": "VOC run 2" }
      }
    },
    "VDA278.TestExecutionFOGDetailed": {
      "type": "object",
      "properties": {
        "Numerator": { "const": 3 },
        "Designation": { "const": "FOG run" },
        "SingleResults": { "$ref": "#/$defs/VDA278.InformationSetFOGDetailed" }
      },
      "required": ["SpecimenID", "SingleResults"]
    },
    "VDA278.Specimen": {
      "type": "object",
      "properties": {
        "ProcessHistory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "$ref": "#/$defs/VDA278.ProcessStepPreconditioning" }],
          "items": false
        }
      },
      "required": ["ProcessHistory"]
    },
    "VDA278.ProcessStepPreconditioning": {
      "type": "object",
      "properties": {
        "Specification": {
          "const": { "Type": "VDA", "Number": "278", "IssueDate": "2016-05" }
        },
        "ProcessData": { "$ref": "#/$defs/VDA278.ProcessDataPreconditioning" }
      },
      "required": ["Specification", "ProcessData"]
    },
    "VDA278.ProcessDataPreconditioning": {
      "type": "object",
      "properties": {
        "Designation": { "const": "Preconditioning" },
        "Attributes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            { "$ref": "#/$defs/VDA278.AttributePreconditioningDuration" },
            { "$ref": "#/$defs/VDA278.AttributePreconditioningEndDate" },
            { "$ref": "#/$defs/VDA278.AttributePreconditioningTempMin" },
            { "$ref": "#/$defs/VDA278.AttributePreconditioningTempMax" },
            { "$ref": "#/$defs/VDA278.AttributePreconditioningHumidMin" },
            { "$ref": "#/$defs/VDA278.AttributePreconditioningHumidMax" }
          ],
          "items": false
        }
      },
      "required": ["Designation", "Attributes"]
    },
    "VDA278.AttributePreconditioningDuration": {
      "type": "object",
      "properties": {
        "Property": { "const": "Duration" },
        "Unit": { "const": "d" },
        "Value": { "type": "number", "minimum": 0.0 }
      }
    },
    "VDA278.AttributePreconditioningEndDate": {
      "type": "object",
      "properties": {
        "Property": { "const": "End date" },
        "Value": { "$ref": "https://vda231-301.github.io/schemas/generic/VDA_231-301_generic_v3.0.0.schema.json#/$defs/Generic.Date" }
      }
    },
    "VDA278.AttributePreconditioningTempMin": {
      "type": "object",
      "properties": {
        "Property": { "const": "Temperature minimum" },
        "Unit": { "const": "°C" },
        "Value": { "type": "number" }
      }
    },
    "VDA278.AttributePreconditioningTempMax": {
      "type": "object",
      "properties": {
        "Property": { "const": "Temperature maximum" },
        "Unit": { "const": "°C" },
        "Value": { "type": "number" }
      }
    },
    "VDA278.AttributePreconditioningHumidMin": {
      "type": "object",
      "properties": {
        "Property": { "const": "Relative humidity minimum" },
        "Unit": { "const": "%" },
        "Value": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
      }
    },
    "VDA278.AttributePreconditioningHumidMax": {
      "type": "object",
      "properties": {
        "Property": { "const": "Relative humidity maximum" },
        "Unit": { "const": "%" },
        "Value": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
      }
    },
    "VDA278.InformationSetVOCDetailed": {
      "allOf": [{ "$ref": "#/$defs/VDA278.InformationSetVOC" }],
      "properties": {
        "ArraySpec": { "$ref": "#/$defs/VDA278.EmissionArraySpec" },
        "ArrayValue": { "$ref": "#/$defs/VDA278.EmissionArrayValue" }
      },
      "required": ["ArraySpec", "ArrayValue"]
    },
    "VDA278.InformationSetVOCSummary": {
      "allOf": [{ "$ref": "#/$defs/VDA278.InformationSetVOC" }],
      "not": {
        "anyOf": [
          { "required": ["ArraySpec"] },
          { "required": ["ArrayValue"] }
        ]
      }
    },
    "VDA278.InformationSetVOC": {
      "type": "object",
      "properties": {
        "_type": { "const": "InformationSet" },
        "Designation": { "const": "VOC" },
        "Attributes": { "$ref": "#/$defs/VDA278.VOCAttributes" }
      },
      "required": ["_id", "_type", "Designation", "Attributes"]
    },
    "VDA278.InformationSetFOGDetailed": {
      "type": "object",
      "properties": {
        "_type": { "const": "InformationSet" },
        "Designation": { "const": "FOG" },
        "Attributes": { "$ref": "#/$defs/VDA278.FOGAttributes" },
        "ArraySpec": { "$ref": "#/$defs/VDA278.EmissionArraySpec" },
        "ArrayValue": { "$ref": "#/$defs/VDA278.EmissionArrayValue" }
      },
      "required": ["_id", "_type", "Designation", "Attributes", "ArraySpec", "ArrayValue"]
    },
    "VDA278.VOCAttributes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        { "$ref": "#/$defs/VDA278.AttributeMethodVOC" },
        { "$ref": "#/$defs/VDA278.AttributeFileName" },
        { "$ref": "#/$defs/VDA278.AttributeVialNumber" },
        { "$ref": "#/$defs/VDA278.AttributeRemark" },
        { "$ref": "#/$defs/VDA278.AttributeSumIdentifiedArea" },
        { "$ref": "#/$defs/VDA278.AttributeSumIdentifiedEmission" },
        { "$ref": "#/$defs/VDA278.AttributeVOCTotalEmission" }
      ],
      "items": false
    },
    "VDA278.FOGAttributes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        { "$ref": "#/$defs/VDA278.AttributeMethodFOG" },
        { "$ref": "#/$defs/VDA278.AttributeFileName" },
        { "$ref": "#/$defs/VDA278.AttributeVialNumber" },
        { "$ref": "#/$defs/VDA278.AttributeRemark" },
        { "$ref": "#/$defs/VDA278.AttributeSumIdentifiedArea" },
        { "$ref": "#/$defs/VDA278.AttributeSumIdentifiedEmission" },
        { "$ref": "#/$defs/VDA278.AttributeFOGTotalEmission" }
      ],
      "items": false
    },
    "VDA278.AttributeMethodVOC": {
      "type": "object",
      "properties": { "Property": { "const": "Method" }, "Value": { "const": "VDA278-VOC.M" } }
    },
    "VDA278.AttributeMethodFOG": {
      "type": "object",
      "properties": { "Property": { "const": "Method" }, "Value": { "const": "VDA278-FOG.M" } }
    },
    "VDA278.AttributeFileName": {
      "type": "object",
      "properties": {
        "Property": { "const": "File name" },
        "Value": { "$ref": "https://vda231-301.github.io/schemas/generic/VDA_231-301_generic_v3.0.0.schema.json#/$defs/Generic.RestrictedString" }
      }
    },
    "VDA278.AttributeVialNumber": {
      "type": "object",
      "properties": {
        "Property": { "const": "Vial number" },
        "Value": { "$ref": "https://vda231-301.github.io/schemas/generic/VDA_231-301_generic_v3.0.0.schema.json#/$defs/Generic.RestrictedString" }
      }
    },
    "VDA278.AttributeRemark": {
      "type": "object",
      "properties": { "Property": { "const": "Remark" }, "Value": { "type": "string" } }
    },
    "VDA278.AttributeSumIdentifiedArea": {
      "type": "object",
      "properties": {
        "Property": { "const": "Sum of identified substances area" },
        "Unit": { "const": "%" },
        "Value": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
      }
    },
    "VDA278.AttributeSumIdentifiedEmission": {
      "type": "object",
      "properties": {
        "Property": { "const": "Sum of identified substances emission" },
        "Unit": { "const": "µg/g" },
        "Value": { "type": "number", "minimum": 0.0 }
      }
    },
    "VDA278.AttributeVOCTotalEmission": {
      "type": "object",
      "properties": {
        "Property": { "const": "VOC total emission value" },
        "Unit": { "const": "µg/g" },
        "Value": { "type": "number", "minimum": 0.0 }
      }
    },
    "VDA278.AttributeFOGTotalEmission": {
      "type": "object",
      "properties": {
        "Property": { "const": "FOG total emission value" },
        "Unit": { "const": "µg/g" },
        "Value": { "type": "number", "minimum": 0.0 }
      }
    },
    "VDA278.EmissionArraySpec": {
      "const": [
        { "Property": "Retention time", "Unit": "min" },
        { "Property": "Substance name" },
        { "Property": "Legacy substance" },
        { "Property": "Mass fragments" },
        { "Property": "Main mass fragment" },
        { "Property": "Potential substance match" },
        { "Property": "CAS registry number" },
        { "Property": "Area", "Unit": "%" },
        { "Property": "Emission", "Unit": "µg/g" },
        { "Property": "CLP classifications" },
        { "Property": "GADSL classifications" },
        { "Property": "Remark" }
      ]
    },
    "VDA278.EmissionArrayValue": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/VDA278.EmissionRow" }
    },
    "VDA278.EmissionRow": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        { "type": "number", "minimum": 0.0 },
        { "type": ["string", "null"] },
        { "type": ["string", "null"] },
        { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
        { "type": "integer", "minimum": 0 },
        { "type": ["string", "null"] },
        {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9]{2,7}-[0-9]{2}-[0-9]$" },
            { "type": "null" }
          ]
        },
        { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        { "type": "number", "minimum": 0.0 },
        { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        { "type": "array", "uniqueItems": true, "items": { "enum": ["D", "P"] } },
        { "type": ["string", "null"] }
      ],
      "items": false
    },
    "VDA278.ReportedPropertyVOCTotalEmission": {
      "type": "object",
      "properties": {
        "Property": { "const": "VOC total emission value" },
        "Unit": { "const": "µg/g" },
        "Value": { "type": "number", "minimum": 0.0 },
        "Aggregation": { "const": "Maximum" },
        "CriterionType": { "const": "Variable/Quantitative" },
        "SingleResultIDs": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true
        }
      },
      "required": ["Property", "Unit", "Value", "Aggregation", "CriterionType", "SingleResultIDs"]
    },
    "VDA278.ReportedPropertyFOGTotalEmission": {
      "type": "object",
      "properties": {
        "Property": { "const": "FOG total emission value" },
        "Unit": { "const": "µg/g" },
        "Value": { "type": "number", "minimum": 0.0 },
        "Aggregation": { "const": "None" },
        "CriterionType": { "const": "Variable/Quantitative" },
        "SingleResultIDs": { "type": "array", "minItems": 1, "maxItems": 1 }
      },
      "required": ["Property", "Unit", "Value", "Aggregation", "CriterionType", "SingleResultIDs"]
    },
    "VDA278.ReportedPropertyCLPClassification": {
      "allOf": [{ "$ref": "#/$defs/VDA278.ReportedPropertyClassification" }],
      "properties": {
        "Property": { "const": "CLP classification" },
        "Value": { "type": "string" }
      }
    },
    "VDA278.ReportedPropertyGADSLClassification": {
      "allOf": [{ "$ref": "#/$defs/VDA278.ReportedPropertyClassification" }],
      "properties": {
        "Property": { "const": "GADSL classification" },
        "Value": { "enum": ["D", "P"] }
      }
    },
    "VDA278.ReportedPropertyClassification": {
      "type": "object",
      "properties": {
        "Aggregation": { "const": "None" },
        "CriterionType": { "const": "Attribute/Qualitative" },
        "ValueType": { "const": "Text" },
        "BusinessKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "Name": { "const": "CAS registry number" },
                "Value": { "type": "string", "pattern": "^[0-9]{2,7}-[0-9]{2}-[0-9]$" }
              },
              "required": ["Name", "Value"]
            }
          ],
          "items": false
        },
        "SingleResultIDs": { "type": "array", "minItems": 1, "maxItems": 1 }
      },
      "required": [
        "Property", "Value", "Aggregation", "CriterionType", "ValueType",
        "BusinessKeys", "SingleResultIDs"
      ]
    }
  }
}
